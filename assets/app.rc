#define RT_MANIFEST 24
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 0,5,1,0
PRODUCTVERSION 0,5,1,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Encode FFS"
      VALUE "ProductName", "Encode FFS"
      VALUE "CompanyName", "PrimeCrew Software"
      VALUE "LegalCopyright", "Copyright (C) 2026 PrimeCrew Software"
      VALUE "FileVersion", "0.5.1"
      VALUE "ProductVersion", "0.5.1"
      VALUE "OriginalFilename", "Encode FFS.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
